{
  "id": "at-tuned",
  "title": "At-Tuned",
  "description": "Replaces the fixed 3-item attunement limit with a per-character point budget weighted by item rarity, with special support for the Artificer class.",
  "version": "0.2.0",
  "compatibility": {
    "minimum": "13.341",
    "verified": "13.351"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.0.0",
          "verified": "5.3.1"
        }
      }
    ],
    "recommends": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "Optional: enables precise calculation of the weighted attunement value at the data model level. Without it, the module falls back to a hook-based recalculation."
      },
      {
        "id": "tidy5e-sheet",
        "type": "module",
        "reason": "Optional: verified compatibility with Tidy5e's character sheet."
      }
    ]
  },
  "authors": [
    {
      "name": "Kaplar"
    }
  ],
  "esmodules": [
    "scripts/at-tuned.mjs"
  ],
  "styles": [
    "styles/at-tuned.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "es",
      "name": "Español",
      "path": "lang/es.json"
    }
  ],
  "url": "https://github.com/Kaplar1208/at-tuned",
  "manifest": "https://raw.githubusercontent.com/Kaplar1208/at-tuned/main/module.json",
  "download": "https://github.com/Kaplar1208/at-tuned/releases/latest/download/at-tuned.zip"
}
