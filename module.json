      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "4.0.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "Permite calcular con precisión el valor ponderado de attunement en el modelo de datos (sin esto, se usa un cálculo alternativo por hooks)."
      },
      {
        "id": "tidy5e-sheet",
        "type": "module",
        "reason": "Compatibilidad verificada con la hoja de personaje de Tidy5e."
      }
    ]
  },
